[Unit]
Description=Deploy tested origin/main to Trick Evolution dev Pi
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /home/pi/services/trick-evolution/bin/deploy-dev-pi.sh --main
TimeoutStartSec=5min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
